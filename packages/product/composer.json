{
    "name": "vitisstudio/tendril-product",
    "description": "Tendril product analytics: feature definitions, rollups, actor activity (exact uniques), funnels, cohorts, retention and journeys.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "analytics",
        "product-analytics",
        "tendril"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "vitisstudio/tendril-core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "VitisStudio\\Tendril\\Product\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VitisStudio\\Tendril\\Product\\ProductServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
