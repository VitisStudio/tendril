{
    "name": "vitisstudio/tendril-core",
    "description": "Tendril core: privacy-safe, fail-open event capture, sessions, identity and ingestion for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "analytics",
        "events",
        "tendril"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "suggest": {
        "livewire/livewire": "Required (^4.0) for server-side Livewire action capture.",
        "predis/predis": "Or ext-redis; enables the redis-buffer transport and Redis presence store.",
        "phpunit/phpunit": "Required by Tendril::fake() assertions (RecordingTransport)."
    },
    "autoload": {
        "psr-4": {
            "VitisStudio\\Tendril\\Core\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VitisStudio\\Tendril\\Core\\TendrilServiceProvider"
            ],
            "aliases": {
                "Tendril": "VitisStudio\\Tendril\\Core\\Facades\\Tendril"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
