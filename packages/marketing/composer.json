{
    "name": "vitisstudio/tendril-marketing",
    "description": "Tendril marketing reporting: conversion definitions, revenue in minor units, first/last/linear/position attribution over touchpoints, campaigns and conversion paths.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "analytics",
        "attribution",
        "utm",
        "tendril"
    ],
    "require": {
        "php": "^8.4",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "vitisstudio/tendril-core": "^1.0",
        "vitisstudio/tendril-product": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "VitisStudio\\Tendril\\Marketing\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VitisStudio\\Tendril\\Marketing\\MarketingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
